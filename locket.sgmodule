#!name=Locket Custom Edition
#!desc=Mod By HaiLong | Tùy chỉnh Video 45s, Khung & Caption cá nhân.
#!author=HaiLong
#!category=Locket
#!system=ios

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 45s & Caption cá nhân (by HaiLong)
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/Long23112002/CSA/locket/locket.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by HaiLong)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Long23112002/CSA/locket/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 25/05/1111 (by HaiLong)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Long23112002/CSA/locket/locket_sub.js, requires-body=true, max-size=-1, timeout=60
